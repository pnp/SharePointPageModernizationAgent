# SharePoint / Azure AD Authentication
#
# Option 1: App-only (client credentials) — set all three:
# SP_TENANT_ID=your-tenant-guid
# SP_CLIENT_ID=your-app-client-id
# SP_CLIENT_SECRET=your-client-secret
#
# Option 2: Interactive user login (device code flow) — just set tenant:
SP_TENANT_ID=
# SP_CLIENT_ID=     # Optional: defaults to PnP Management Shell app
# SP_CLIENT_SECRET=  # Leave empty to trigger device code flow
#
# AUTH_MODE=device_code  # Or "client_credential". Auto-detected from SP_CLIENT_SECRET.

# Optional: Override LLM for IR generation (not used by MCP server itself)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
